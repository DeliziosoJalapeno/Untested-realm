# Copy this file to ".env" (same folder) and fill in what you need. The server reads it at startup.
# .env is ignored by git — never commit a real key.

# The "Claude" computer opponent. Get a key at https://console.anthropic.com/ (API keys).
ANTHROPIC_API_KEY=

# Optional settings for the Claude opponent (defaults shown):
# CLAUDE_BOT_MODEL=claude-sonnet-5-5     # claude-opus-5-5 is stronger and slower; claude-haiku-5-5 faster and cheaper
# CLAUDE_BOT_EFFORT=low                  # thinking effort: off | low | medium | high. off = no thinking: cheapest and fastest
# CLAUDE_BOT_ACCESS=local                # local = this machine + the admin account; users = any signed-in user; all
# CLAUDE_BOT_RPM=40                      # at most this many Claude moves per minute, server-wide

# Copy this file to ".env" (same folder) and fill in what you need. The server reads it at startup.
# .env is ignored by git — never commit a real key.

# The "Claude" computer opponent. Get a key at https://console.anthropic.com/ (API keys).
ANTHROPIC_API_KEY=

# Optional settings for the Claude opponent (defaults shown):
# CLAUDE_BOT_MODEL=claude-sonnet-5-5     # claude-opus-5-5 is the strongest (slower, dearer); claude-haiku-5-5 faster and cheaper
# CLAUDE_BOT_EFFORT=medium               # thinking effort: off | low | medium | high. Higher = stronger, slower, dearer
# CLAUDE_BOT_ACCESS=local                # local = this machine + the admin account; users = any signed-in user; all
# CLAUDE_BOT_RPM=40                      # at most this many Claude moves per minute, server-wide

# Play Sorcery Online statistics (card win rates used by the bots). Only needed to REFRESH the saved
# snapshot with "npm run pso:sync" — the app itself never calls PSO. Keys: https://realmdraft.net/analytics-developers
PSO_API_KEY=

# The game archive on a hosted site. With a GitHub token that may write the repository's contents
# (a fine-grained token: Contents = Read and write, for that one repository), every finished game
# against the computer is committed to a branch, with the engine report and Claude's review.
# On your own machine games are written to match-replays/ instead and this is not needed.
GAME_ARCHIVE_TOKEN=
# GAME_ARCHIVE_REPO=BarelyCoded/Untested-realm
# GAME_ARCHIVE_BRANCH=match-replays
# GAME_ARCHIVE_PER_HOUR=40               # at most this many saves per visitor address per hour
